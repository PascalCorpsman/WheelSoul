{
  "name": "wheelsoul",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config src/web/vite.config.ts --host 127.0.0.1",
    "build": "tsc -p src/web/tsconfig.json && vite build --config src/web/vite.config.ts",
    "test": "node --test src/web/tests/*.test.mjs",
    "lint": "oxlint src/web",
    "start": "PYTHONPATH=src .venv/bin/python -m wheelsoul"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}

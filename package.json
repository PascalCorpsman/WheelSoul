{
  "name": "wheelsoul",
  "version": "0.0.1",
  "displayVersion": "0.01",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config src/web/vite.config.ts --host 127.0.0.1",
    "build": "tsc -p src/web/tsconfig.json && vite build --config src/web/vite.config.ts",
    "test": "node --test src/web/tests/*.test.mjs src_android/tests/*.test.mjs",
    "lint": "oxlint src/web src_android/native",
    "start": "PYTHONPATH=src .venv/bin/python -m wheelsoul"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "js-md5": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "rimraf": {
      "glob": "^14.0.3"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
